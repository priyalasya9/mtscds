============================================================

CODE (Main.java)
------------------------------------------------------------
public class Main {
    static void test(int a, int b, char op, int exp) {
        int res = 0;
        if (op == '+') res = a + b;
        if (op == '-') res = a - b;
        if (op == '*') res = a * b;
        System.out.println(
            a + " " + op + " " + b + " = " + res +
            (res == exp ? " PASS" : " FAIL"));
    }
    public static void main(String[] args) {
        test(2, 3, '+', 5);
        test(10, 4, '-', 6);
        test(3, 3, '*', 9);
        test(5, 5, '-', 1);
    }
}
OUTPUT
------------------------------------------------------------
2 + 3 = 5 PASS
10 - 4 = 6 PASS
3 * 3 = 9 PASS
5 - 5 = 0 FAIL
