CODE (JD.java)
------------------------------------------------------------
import java.sql.*;
public class JD {
    public static void main(String[] args) {
        try {
            Connection con = DriverManager.getConnection(
                "jdbc:sqlite:StudentDB.db");
            Statement st = con.createStatement();
            st.execute("CREATE TABLE IF NOT EXISTS STUDENT " +
                       "(ID INTEGER, NAME TEXT, EMAIL TEXT)");
            st.execute("DELETE FROM STUDENT");
            st.execute("INSERT INTO STUDENT VALUES " +
                       "(1, 'AJAY', 'AJAY@MAIL.COM')");
            ResultSet rs = st.executeQuery(
                "SELECT NAME FROM STUDENT WHERE ID=1");
            if (rs.next()) {
                String actual = rs.getString("NAME");
                String expected = "AJAY";
                System.out.println("Expected: " + expected);
                System.out.println("Actual: " + actual);
                if (actual.equals(expected))
                    System.out.println("PASS");
                else
                    System.out.println("FAIL");
            }
            con.close();
        } catch (Exception e) {
            System.out.println(e);
        }
    }
}
