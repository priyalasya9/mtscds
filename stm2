import java.awt.*;
import java.awt.event.KeyEvent;
import java.awt.image.BufferedImage;
import javax.imageio.ImageIO;
import java.io.File;
public class Main {
    static void key(Robot r, int k) {
        r.keyPress(k);
        r.keyRelease(k);
    }
    public static void main(String[] args) throws Exception {
        Runtime.getRuntime().exec("calc.exe");
        Thread.sleep(2000);
        Robot r = new Robot();
        key(r, KeyEvent.VK_7);
        key(r, KeyEvent.VK_ADD);
        key(r, KeyEvent.VK_5);
        key(r, KeyEvent.VK_EQUALS);
        Thread.sleep(1000);
        Rectangle screen =
            new Rectangle(Toolkit.getDefaultToolkit().getScreenSize());
        BufferedImage img =
            r.createScreenCapture(screen);
        ImageIO.write(
            img, "png", new File("result.png"));
        System.out.println("7 + 5 = 12");
        System.out.println("Screenshot saved");
    }
}
